# ==============================================================================
# SportsBetIA — Variables de Entorno y Claves API
# ==============================================================================
# Copia este archivo como .env y añade tus claves de acceso de los proveedores oficiales.
#
# NUNCA compartas ni subas tu archivo .env a repositorios públicos.
# ==============================================================================

# 1. API-Football (api-sports.io via RapidAPI / Direct)
# Registra tu cuenta gratuita en: https://dashboard.api-football.com/register
APIFOOTBALL_KEY=tu_clave_apifootball_aqui

# 2. Football-Data.org
# Registra tu cuenta gratuita en: https://www.football-data.org/client/register
FOOTBALLDATA_TOKEN=tu_token_footballdata_aqui
